# ---- required ----------------------------------------------------------
# Shared secret for the REST API and MCP endpoint. Generate with:
#   openssl rand -hex 32
ACCESS_KEY=

# ---- Jira sync (omit the whole block to disable) -----------------------
# A partly filled block is a startup error, never a silent disable.
JIRA_EMAIL=
JIRA_API_TOKEN=
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://minuthq.atlassian.net
# Default query: assigned to you, not an Epic or Story, In Progress or In Review.
# issuetype is excluded rather than listed so the Swedish subtask type
# "Deluppgift" in the WEB project is included too.
#JIRA_JQL=
JIRA_TARGET_SUBDIR=Work/Jira
JIRA_TASK_CONTEXT=Work
# TaskNotes status for Jira "In Review". Your TaskNotes config only defines
# none/open/in-progress/done, so this is in-progress until you add in-review.
JIRA_REVIEW_STATUS=in-progress
# Safety net behind the webhook; webhooks do get dropped.
JIRA_RECONCILE_CRON=*/20 * * * *
# Optional shared secret. Jira calls POST /jira/webhook?secret=<value>
JIRA_WEBHOOK_SECRET=
JIRA_WEBHOOK_DEBOUNCE_MS=2000

# ---- S3 backup (omit the whole block to disable) -----------------------
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_PREFIX=vault-backups
S3_FORCE_PATH_STYLE=true
BACKUP_CRON=0 3 * * *

# ---- CouchDB, only for the encrypted backup artifact -------------------
# Without these you still get the plaintext zip, just not the raw export.
COUCHDB_URL=http://couchdb:5984
COUCHDB_DB=
COUCHDB_USER=
COUCHDB_PASSWORD=

LOG_LEVEL=info
