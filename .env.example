# Secrets only. Everything else (the JQL, where notes live, schedules,
# bucket, CouchDB location) belongs in config/vault-service.json.
#
# Precedence is defaults < config file < this file. Any setting from the
# config file can still be overridden here per deployment, using the
# commented variable names listed at the bottom.

# ---- required ----------------------------------------------------------
# REST API and MCP share this one key. Generate with: openssl rand -hex 32
ACCESS_KEY=

# ---- Jira sync: set both to enable, or neither to disable --------------
# A partly filled group is a startup error, never a silent disable.
JIRA_EMAIL=
JIRA_API_TOKEN=
# https://id.atlassian.com/manage-profile/security/api-tokens
# The Jira host has no default. Set jira.baseUrl in the config file, or
# uncomment this:
#JIRA_BASE_URL=https://your-domain.atlassian.net

# Optional. Jira calls POST /jira/webhook?secret=<value>
JIRA_WEBHOOK_SECRET=

# ---- S3 backup: set both to enable, or neither to disable --------------
# The bucket itself goes in the config file under backup.bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- CouchDB + vault encryption ----------------------------------------
# Used by livesync-bridge to replicate the vault, and by the service for the
# raw encrypted backup artifact.
#
# These are also the only place the vault passphrase appears. The bridge
# reads credentials solely from a config file and has no environment support,
# so that file is rendered from these variables into a tmpfs volume at start
# and the secrets never touch disk.
COUCHDB_URL=https://couchdb.example.com
COUCHDB_DB=
COUCHDB_USER=
COUCHDB_PASSWORD=
# The same passphrase the LiveSync plugin uses. Treat as your most sensitive
# secret: it is what makes the vault readable.
VAULT_E2EE_PASSPHRASE=

# How much of the vault the bridge syncs. Narrow by default so a wrong
# config affects one folder, not everything. Set to an empty value to sync
# the whole vault, which is honoured as written.
BRIDGE_BASE_DIR=Work/Jira/

LOG_LEVEL=info

# ---- host paths ---------------------------------------------------------
# Absolute paths on the host, deliberately outside the repo checkout so a
# redeploy cannot replace them. Create them before the first start:
#   sudo mkdir -p /data/vault-service/config
CONFIG_DIR=/data/vault-service/config
# Leave unset to keep the vault in a Docker named volume. Set an absolute
# path to put the plain markdown somewhere you can inspect and back up.
#VAULT_HOST_PATH=/data/vault-service/vault

# How often the config file is re-read, in milliseconds. Edits to it apply
# without a restart; see "Changing config without redeploying" in the README.
#CONFIG_POLL_MS=10000

# ---- ports --------------------------------------------------------------
# Host side. Change this one if the default is already taken on the host.
# Published on 127.0.0.1 only, since auth is a single shared key.
HOST_PORT=8181
# Container side. Rarely needs changing; nothing else runs in there.
# In Docker set the port here rather than in the config file, so the compose
# port mapping and the app agree. Environment wins over the config file.
PORT=8080

# ---- optional overrides of config file values --------------------------
# Uncomment only to override what config/vault-service.json already says.
#CONFIG_FILE=/config/vault-service.json
#VAULT_DIR=/vault
#JIRA_JQL=
#JIRA_TARGET_SUBDIR=
#JIRA_TASK_CONTEXT=
#JIRA_STATUS_MAP={"In Review":"in-review"}
#JIRA_DEFAULT_STATUS=
#JIRA_RECONCILE_CRON=
#JIRA_WEBHOOK_DEBOUNCE_MS=
#BACKUP_CRON=
#S3_BUCKET=
#S3_ENDPOINT=
#S3_REGION=
#S3_PREFIX=
#S3_FORCE_PATH_STYLE=
#COUCHDB_URL=
#COUCHDB_DB=
