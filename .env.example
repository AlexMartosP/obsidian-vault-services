# Secrets only. Everything else (the JQL, where notes live, schedules,
# bucket, CouchDB location) belongs in config/vault-service.json.
#
# Precedence is defaults < config file < this file. Any setting from the
# config file can still be overridden here per deployment, using the
# commented variable names listed at the bottom.

# ---- required ----------------------------------------------------------
# REST API and MCP share this one key. Generate with: openssl rand -hex 32
ACCESS_KEY=

# ---- Jira sync: set both to enable, or neither to disable --------------
# A partly filled group is a startup error, never a silent disable.
JIRA_EMAIL=
JIRA_API_TOKEN=
# https://id.atlassian.com/manage-profile/security/api-tokens
# The Jira host has no default. Set jira.baseUrl in the config file, or
# uncomment this:
#JIRA_BASE_URL=https://your-domain.atlassian.net

# Optional. Jira calls POST /jira/webhook?secret=<value>
JIRA_WEBHOOK_SECRET=

# ---- S3 backup: set both to enable, or neither to disable --------------
# The bucket itself goes in the config file under backup.bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- CouchDB: only for the raw encrypted backup artifact ---------------
# Without these you still get the plaintext zip, just not the raw export.
# The url and database go in the config file under couchdb.
COUCHDB_USER=
COUCHDB_PASSWORD=

LOG_LEVEL=info

# ---- optional overrides of config file values --------------------------
# Uncomment only to override what config/vault-service.json already says.
#CONFIG_FILE=/config/vault-service.json
#VAULT_DIR=/vault
#PORT=8080
#JIRA_JQL=
#JIRA_TARGET_SUBDIR=
#JIRA_TASK_CONTEXT=
#JIRA_STATUS_MAP={"In Review":"in-review"}
#JIRA_DEFAULT_STATUS=
#JIRA_RECONCILE_CRON=
#JIRA_WEBHOOK_DEBOUNCE_MS=
#BACKUP_CRON=
#S3_BUCKET=
#S3_ENDPOINT=
#S3_REGION=
#S3_PREFIX=
#S3_FORCE_PATH_STYLE=
#COUCHDB_URL=
#COUCHDB_DB=
